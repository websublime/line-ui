{
  "name": "@websublime/line-ui",
  "author": {
    "email": "hello@miguelramos.dev",
    "name": "miguelramos",
    "url": "https://github.com/miguelramos"
  },
  "bugs": {
    "url": "https://github.com/websublime/line-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com:websublime/line-ui.git"
  },
  "private": true,
  "version": "1.0.0",
  "description": "Headless UI primitives as native Web Components",
  "scripts": {
    "changeset": "changeset",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "build": "bun --filter '@websublime/*' build",
    "version": "changeset version",
    "release": "changeset publish",
    "status": "changeset status --since=main",
    "empty": "changeset --empty",
    "snapshot:version": "changeset version --snapshot",
    "snapshot:publish": "changeset publish --snapshot --tag canary",
    "prepare": "git config core.hooksPath .githooks"
  },
  "keywords": [
    "components",
    "lit",
    "ui",
    "lib",
    "web-components",
    "headless"
  ],
  "license": "ISC",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.0",
    "@changesets/get-github-info": "^0.8.0",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@happy-dom/global-registrator": "^20.10.5",
    "@open-wc/testing-helpers": "^3.0.1",
    "@phosphor-icons/core": "^2.1.1",
    "@radix-ui/colors": "^3.0.0",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/addon-themes": "^10.4.0",
    "@storybook/web-components-vite": "^10.4.0",
    "@types/node": "^25.4.0",
    "@zag-js/core": "^1.40.0",
    "@zag-js/vanilla": "^1.40.0",
    "astro": "^5.18.1",
    "cssnano": "^8.0.1",
    "lit": "^3.3.3",
    "lucide-static": "^1.16.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5.14",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.1.1",
    "postcss-nested": "^7.0.2",
    "postcss-preset-env": "^11.3.0",
    "storybook": "^10.4.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.13",
    "vite-plugin-dts": "^5.0.0",
    "zod": "^3.25.76"
  }
}
