{
  "name": "@websublime/line-ui",
  "author": {
    "email": "hello@miguelramos.dev",
    "name": "miguelramos",
    "url": "https://github.com/miguelramos"
  },
  "bugs": {
    "url": "https://github.com/websublime/line-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com:websublime/line-ui.git"
  },
  "private": true,
  "version": "1.0.0",
  "description": "Headless UI primitives as native Web Components",
  "scripts": {
    "changeset": "changeset",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "build": "bun --filter './packages/*' build && bun --filter './apps/*' build",
    "test": "bun --filter '@websublime/line-schemas' --filter '@websublime/line-tokens' --filter '@websublime/line-colors' --filter '@websublime/line-themes' build && bun test packages/line-themes/__tests__/",
    "e2e": "playwright test --pass-with-no-tests",
    "version": "changeset version && bun install --ignore-scripts",
    "release": "bun run scripts/publish.mjs",
    "status": "changeset status --since=main",
    "empty": "changeset --empty",
    "snapshot:version": "changeset version --snapshot",
    "snapshot:publish": "bun run scripts/publish.mjs --tag canary --no-git-tag",
    "prepare": "git config core.hooksPath .githooks"
  },
  "keywords": [
    "components",
    "lit",
    "ui",
    "lib",
    "web-components",
    "headless"
  ],
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "bun": ">=1.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@changesets/get-github-info": "^0.8.0",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@happy-dom/global-registrator": "^20.14.6",
    "@open-wc/testing-helpers": "^3.0.1",
    "@phosphor-icons/core": "^2.1.1",
    "@radix-ui/colors": "^3.0.0",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/web-components-vite": "^10.6.2",
    "@types/node": "^25.9.9",
    "@zag-js/core": "^1.46.0",
    "@zag-js/vanilla": "^1.46.0",
    "cssnano": "^8.0.10",
    "lit": "^3.3.3",
    "lucide-static": "^1.56.0",
    "playwright": "^1.64.0",
    "postcss": "^8.5.30",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.2.0",
    "postcss-nested": "^7.0.2",
    "postcss-preset-env": "^11.6.1",
    "storybook": "^10.6.2",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "zod": "^3.25.76"
  }
}
