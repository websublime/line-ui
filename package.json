{
  "name": "@websublime/line-ui",
  "author": {
    "email": "hello@miguelramos.dev",
    "name": "miguelramos",
    "url": "https://github.com/miguelramos"
  },
  "bugs": {
    "url": "https://github.com/websublime/line-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com:websublime/line-ui.git"
  },
  "private": true,
  "version": "1.0.0",
  "description": "Headless UI primitives as native Web Components",
  "scripts": {
    "changeset": "changeset",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "build": "bun --filter '@websublime/*' build",
    "version": "changeset version",
    "release": "changeset publish",
    "status": "changeset status --since=main",
    "empty": "changeset --empty",
    "snapshot:version": "changeset version --snapshot",
    "snapshot:publish": "changeset publish --snapshot --tag canary",
    "prepare": "git config core.hooksPath .githooks"
  },
  "keywords": [
    "components",
    "lit",
    "ui",
    "lib",
    "web-components",
    "headless"
  ],
  "license": "ISC",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@changesets/get-github-info": "^0.8.0",
    "typescript": "^5.9.3"
  }
}
