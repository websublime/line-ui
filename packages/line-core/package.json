{
  "name": "@websublime/line-core",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./machine": {
      "types": "./dist/machine/index.d.ts",
      "import": "./dist/machine/index.js"
    },
    "./styles": {
      "types": "./dist/styles/index.d.ts",
      "import": "./dist/styles/index.js"
    },
    "./mixins/*": {
      "types": "./dist/mixins/*.d.ts",
      "import": "./dist/mixins/*.js"
    }
  },
  "dependencies": {
    "@zag-js/core": "^1.40.0",
    "@zag-js/vanilla": "^1.40.0",
    "lit": "^3.3.3"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  }
}
