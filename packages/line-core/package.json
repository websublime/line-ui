{
  "name": "@websublime/line-core",
  "version": "0.1.3",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/websublime/line-ui.git",
    "directory": "packages/line-core"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./machine": {
      "types": "./dist/machine/index.d.ts",
      "import": "./dist/machine/index.js"
    },
    "./styles": {
      "types": "./dist/styles/index.d.ts",
      "import": "./dist/styles/index.js"
    },
    "./mixins/*": {
      "types": "./dist/mixins/*.d.ts",
      "import": "./dist/mixins/*.js"
    }
  },
  "dependencies": {
    "@zag-js/core": "^1.46.0",
    "@zag-js/vanilla": "^1.46.0",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@websublime/line-testing": "workspace:^",
    "htmx2": "npm:htmx.org@2.0.11",
    "htmx4": "npm:htmx.org@4.0.0"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json --noEmit false --emitDeclarationOnly",
    "dev": "trap 'kill 0' INT TERM; vite build --watch & tsc -p tsconfig.json --noEmit false --emitDeclarationOnly --watch & wait",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  }
}
