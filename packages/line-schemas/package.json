      "types": "./dist/contrast-table.d.ts",
      "import": "./dist/contrast-table.js"
    }
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit"
  }
}
