{
  "name": "@websublime/line-schemas",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contrast-table": {
      "types": "./dist/contrast-table.d.ts",
      "import": "./dist/contrast-table.js"
    }
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit"
  }
}
