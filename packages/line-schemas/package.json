{
  "name": "@websublime/line-schemas",
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/websublime/line-ui.git",
    "directory": "packages/line-schemas"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
