{
  "name": "@websublime/line-components",
  "version": "0.2.1",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "custom-elements.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/websublime/line-ui.git",
    "directory": "packages/line-components"
  },
  "customElements": "./custom-elements.json",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./custom-elements.json": "./custom-elements.json",
    "./button": {
      "types": "./dist/button/index.d.ts",
      "import": "./dist/button/index.js"
    },
    "./stack": {
      "types": "./dist/stack/index.d.ts",
      "import": "./dist/stack/index.js"
    }
  },
  "dependencies": {
    "@websublime/line-core": "workspace:^",
    "@websublime/line-themes": "workspace:^",
    "@websublime/line-tokens": "workspace:^",
    "@websublime/line-utils": "workspace:^",
    "@zag-js/core": "^1.47.0",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@websublime/line-schemas": "workspace:^",
    "@websublime/line-testing": "workspace:^"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json --noEmit false --emitDeclarationOnly && bun run analyze",
    "analyze": "custom-elements-manifest analyze --config custom-elements-manifest.config.mjs",
    "dev": "trap 'kill 0' INT TERM; vite build --watch & tsc -p tsconfig.json --noEmit false --emitDeclarationOnly --watch & wait",
    "clean": "rm -rf dist custom-elements.json",
    "typecheck": "tsc --noEmit"
  }
}
